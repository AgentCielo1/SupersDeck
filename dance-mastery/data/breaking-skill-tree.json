      "family": "toprock",
      "name": "Two-step / cross step",
      "phase": 1,
      "prereqs": [
        {
          "id": "toprock.groove",
          "kind": "hard"
        }
      ],
      "anchor": "1-2 weeks; styling is forever",
      "checkpoints": [
        "step crosses the center line, weight fully transfers",
        "arms open on the step, close on the return",
        "chest stays proud — no folding forward",
        "land back on the 'and' count, ready to repeat"
      ],
      "mistakes": [
        "stepping too wide to recover in time",
        "arms flailing instead of framing the step"
      ]
    },
